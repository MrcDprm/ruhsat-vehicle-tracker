{
  "expo": {
    "name": "Ruhsat",
    "slug": "ruhsat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ruhsat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.miracdeprem.ruhsat",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon/icon-light.png",
        "dark": "./assets/icon/icon-dark.png",
        "tinted": "./assets/icon/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "tr": "./locales/ios-tr.json",
      "en": "./locales/ios-en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EEE5",
          "image": "./assets/icon/splash.png",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/icon/splash-dark.png",
            "backgroundColor": "#15171A"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "499e1dfa-66f3-4e05-b25f-3a839c60b05b"
      }
    },
    "owner": "mrcdprm"
  }
}
